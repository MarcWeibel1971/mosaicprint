# PostgreSQL connection string (provided by Railway automatically)
DATABASE_URL=postgresql://user:password@host:5432/mosaicprint

# Image import API keys
PEXELS_API_KEY=your_pexels_api_key
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Stripe (for payments)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Your production domain (for Stripe success/cancel URLs)
BASE_URL=https://your-app.railway.app

# Server port (Railway sets this automatically)
PORT=3000

# SMTP (for sending mosaic emails to event participants)
# Outlook/Hotmail: SMTP_HOST=smtp-mail.outlook.com, PORT=587, SECURE=false
# Gmail: SMTP_HOST=smtp.gmail.com, PORT=587, SECURE=false
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@outlook.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@outlook.com

# Node environment
NODE_ENV=production
